# ─────────────────────────────────────────────────
#  Eduvia — Environment Variables Template
#  Copy this file to .env and fill in real values.
#  NEVER commit .env to version control.
# ─────────────────────────────────────────────────

# ── Application ──────────────────────────────────
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_STRONG_RANDOM_SECRET

# ── Database (PostgreSQL) ─────────────────────────
DATABASE_URL=postgresql+asyncpg://eduvia:eduvia_password@localhost:5432/eduvia_db
POSTGRES_USER=eduvia
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
POSTGRES_DB=eduvia_db

# ── Vector Database (Qdrant) ─────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ── AI Provider (Gemini) ─────────────────────────
GEMINI_API_KEY=CHANGE_ME_GEMINI_API_KEY
GEMINI_MODEL=gemini-2.0-flash-exp

# ── JWT Authentication ────────────────────────────
JWT_SECRET=CHANGE_ME_JWT_SECRET_MIN_32_CHARS
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Frontend API Base ─────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
