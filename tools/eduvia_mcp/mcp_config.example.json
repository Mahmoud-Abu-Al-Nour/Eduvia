{
  "mcpServers": {
    "eduvia-local": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        "tools/eduvia_mcp",
        "python",
        "-m",
        "eduvia_mcp"
      ]
    },
    "eduvia-remote": {
      "serverUrl": "https://<YOUR-CLOUD-RUN-URL>/mcp"
    }
  }
}
