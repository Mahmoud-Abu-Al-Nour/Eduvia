# ─────────────────────────────────────────────────────────────────────────────
# Eduvia Monorepo — Git Ignore Strategy
# Architecture: Centralized Root Configuration
# Covers: backend (FastAPI), frontend (React/Vite), tools (Eduvia MCP),
#         infrastructure (Terraform/Docker), documentation, and local tooling.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Secrets & Environment Overrides (CRITICAL) ──────────────────────────────
# Ignore all actual environment secret files at any depth
.env
.env.*
**/.env
**/.env.*
*.pem
*.key
*.cert
secrets/
**/.secrets/

# PRESERVE all committed environment templates & configuration examples
!.env.example
!**/.env.example
!**/.env*.example

# ─── Python Bytecode & Compilation Caches ────────────────────────────────────
# Universal Python artifacts (backend, tools/eduvia_mcp, scripts, root)
__pycache__/
**/*__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so

# ─── Python Virtual Environments & Tooling ───────────────────────────────────
# Virtual environments at any depth (.venv, backend/.venv, tools/eduvia_mcp/.venv)
.venv/
**/.venv/
venv/
**/venv/
env/
**/env/
ENV/
.uv/
**/.uv/

# ─── Python Package Builds & Distributions ───────────────────────────────────
# Package distribution and egg-info metadata (backend, eduvia_mcp)
*.egg
*.egg-info/
**/*.egg-info/
/dist/
/build/
*.whl

# ─── Python Testing, Coverage & Type-Checking ─────────────────────────────────
# Test runners, coverage reports, and linter caches
.pytest_cache/
**/.pytest_cache/
htmlcov/
.coverage
.coverage.*
**/.coverage
**/.coverage.*
coverage.xml
*.coveragerc
.mypy_cache/
**/.mypy_cache/
.ruff_cache/
**/.ruff_cache/

# ─── Node / Frontend (React + Vite) ──────────────────────────────────────────
# Node package dependencies and npm/yarn caches
node_modules/
**/node_modules/
.pnp
.pnp.js
.yarn/install-state.gz
.npm/

# Frontend production bundle and temporary dev build cache
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo
frontend/vite.config.ts.timestamp-*.mjs

# ─── Infrastructure & Cloud Deployment ────────────────────────────────────────
# Docker local overrides
docker-compose.override.yml

# Terraform local runtime state and variables (preserve *.tf and *.tf.example)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log
crash.*.log

# ─── Documentation & Knowledge Vaults ────────────────────────────────────────
# Obsidian user workspace window state (preserve vault configuration)
**/.obsidian/workspace.json
**/.obsidian/workspace-mobile.json

# ─── Local Development Tools & Binaries ──────────────────────────────────────
# Local portable PostgreSQL binaries and archive
tools/pgsql/
tools/pgsql_binaries.zip

# ─── Scratch, Temporary & Log Files ──────────────────────────────────────────
# Developer scratch testing scripts and runtime logs
scratch/
*.log
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Operating System & IDE Artifacts ────────────────────────────────────────
# OS metadata files
.DS_Store
**/.DS_Store
Thumbs.db
ehthumbs.db

# Editor swap and backup files
*.swp
*.swo
*~
.idea/
.direnv/

# VS Code personal settings (preserve shared repository .vscode/settings.json)
.vscode/*
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
